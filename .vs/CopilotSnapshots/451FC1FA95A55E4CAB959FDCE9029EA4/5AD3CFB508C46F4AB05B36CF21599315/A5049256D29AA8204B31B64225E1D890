/**
 * @file CharacterForm.tsx
 * @description Interactive form component allowing users to build a custom D&D character sheet
 * from scratch, specifying stats, class, level, and visual appearance.
 */

'use client';

import { useState } from 'react';
import type { CharacterSheet } from '@/types/campaign';
import { DEFAULT_SKILLS, calculateProficiencyBonus } from '@/utils/dnd';

interface Props {
    onCharacterCreated: (newCharacter: CharacterSheet) => void;
}

export default function CharacterForm({ onCharacterCreated }: Props) {
    // Form input states
    const [name, setName] = useState('');
    const [characterClass, setCharacterClass] = useState('');
    const [level, setLevel] = useState(1);
    const [maxHp, setMaxHp] = useState(20);
    const [appearanceDescription, setAppearanceDescription] = useState('');

    // Ability scores state
    const [stats, setStats] = useState({
        strength: 10,
        dexterity: 10,
        constitution: 10,
        intelligence: 10,
        wisdom: 10,
        charisma: 10,
    });

    const [inventoryInput, setInventoryInput] = useState('');

    // Handle stat number changes safely
    const handleStatChange = (stat: keyof typeof stats, value: number) => {
        setStats((prev) => ({ ...prev, [stat]: Math.max(1, Math.min(30, value)) }));
    };

    const handleSubmit = (e: React.FormEvent) => {
        e.preventDefault();
        if (!name.trim() || !characterClass.trim()) return;

        // Construct the new CharacterSheet object
        const newCharacter: CharacterSheet = {
            id: `char-${Date.now()}`, // Unique ID using timestamp
            name,
            race: 'Human',
            characterClass,
            background: 'Folk Hero',
            alignment: 'NG',
            level: Number(level),
            proficiencyBonus: calculateProficiencyBonus(Number(level)),
            stats,
            skills: DEFAULT_SKILLS.map((skill) => ({ ...skill, isProficient: false })),
            feats: [],
            spells: [],
            currentHp: Number(maxHp),
            maxHp: Number(maxHp),
            armorClass: 10 + Math.floor((stats.dexterity - 10) / 2),
            appearanceDescription: appearanceDescription || 'A mysterious adventurer ready for anything.',
            inventory: inventoryInput ? inventoryInput.split(',').map((item) => item.trim()) : ['Adventurer Pack'],
        };

        onCharacterCreated(newCharacter);

        // Reset form fields
        setName('');
        setCharacterClass('');
        setAppearanceDescription('');
        setInventoryInput('');
    };

    return (
        <form onSubmit={handleSubmit} className="max-w-md w-full bg-slate-900 border border-slate-800 rounded-xl p-6 text-slate-100 shadow-xl space-y-5">
            <div>
                <h2 className="text-xl font-bold text-amber-500">Forge New Character</h2>
                <p className="text-xs text-slate-400">Design your hero to add them to the campaign roster.</p>
            </div>

            {/* Basic Info */}
            <div className="space-y-3">
                <div>
                    <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">Character Name</label>
                    <input
                        type="text"
                        required
                        value={name}
                        onChange={(e) => setName(e.target.value)}
                        placeholder="e.g., Varis Shadowsinger"
                        className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                    />
                </div>

                <div className="grid grid-cols-2 gap-3">
                    <div>
                        <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">Class & Subclass</label>
                        <input
                            type="text"
                            required
                            value={characterClass}
                            onChange={(e) => setCharacterClass(e.target.value)}
                            placeholder="e.g., Rogue - Thief"
                            className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                        />
                    </div>
                    <div>
                        <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">Level / Max HP</label>
                        <div className="flex gap-2">
                            <input
                                type="number"
                                min="1"
                                max="20"
                                value={level}
                                onChange={(e) => setLevel(Number(e.target.value))}
                                className="w-1/2 bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white text-center focus:outline-none focus:border-amber-500"
                            />
                            <input
                                type="number"
                                min="1"
                                value={maxHp}
                                onChange={(e) => setMaxHp(Number(e.target.value))}
                                className="w-1/2 bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white text-center focus:outline-none focus:border-amber-500"
                            />
                        </div>
                    </div>
                </div>
            </div>

            {/* Ability Scores Grid */}
            <div>
                <label className="block text-xs uppercase tracking-wider text-slate-400 mb-2 font-semibold">Ability Scores</label>
                <div className="grid grid-cols-3 gap-2">
                    {Object.entries(stats).map(([statKey, val]) => (
                        <div key={statKey} className="bg-slate-950 border border-slate-800 rounded-lg p-2 text-center">
                            <span className="block text-[10px] uppercase font-bold text-slate-400 mb-1">{statKey.slice(0, 3)}</span>
                            <input
                                type="number"
                                min="1"
                                max="30"
                                value={val}
                                onChange={(e) => handleStatChange(statKey as keyof typeof stats, Number(e.target.value))}
                                className="w-full bg-slate-900 border border-slate-700 rounded text-center text-sm font-bold text-white p-1 focus:outline-none focus:border-amber-500"
                            />
                        </div>
                    ))}
                </div>
            </div>

            {/* Appearance Description for AI Prompting */}
            <div>
                <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">Visual Traits (For AI Art Generation)</label>
                <textarea
                    rows={2}
                    value={appearanceDescription}
                    onChange={(e) => setAppearanceDescription(e.target.value)}
                    placeholder="e.g., A stealthy tiefling with crimson skin, dark horns, and leather armor holding twin daggers."
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-amber-500 resize-none"
                />
            </div>

            {/* Inventory Items */}
            <div>
                <label className="block text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">Inventory (Comma separated)</label>
                <input
                    type="text"
                    value={inventoryInput}
                    onChange={(e) => setInventoryInput(e.target.value)}
                    placeholder="Dagger, Thieves' Tools, Leather Armor"
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                />
            </div>

            <button
                type="submit"
                className="w-full py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-semibold rounded-lg transition text-sm shadow-md"
            >
                Add Character to Campaign
            </button>
        </form>
    );
}