/**
 * @file CharacterSheetCard.tsx
 * @description Interactive React component displaying a D&D character sheet
 * with live HP controls and AI portrait generation.
 */

'use client';

import { useState } from 'react';
import type { CharacterSheet } from '@/types/campaign';
import { calculateModifier, formatModifier } from '@/utils/dnd';

interface Props {
    character: CharacterSheet;
}

export default function CharacterSheetCard({ character }: Props) {
    // State for HP tracking
    const [hp, setHp] = useState<number>(character.currentHp);

    // State for AI Art Generation
    const [avatarUrl, setAvatarUrl] = useState<string | null>(character.avatarUrl || null);
    const [isGenerating, setIsGenerating] = useState<boolean>(false);
    const [errorMsg, setErrorMsg] = useState<string | null>(null);

    const handleHpChange = (delta: number) => {
        setHp((prevHp) => {
            const nextHp = prevHp + delta;
            return Math.min(character.maxHp, Math.max(0, nextHp));
        });
    };

    /**
     * Calls our Next.js API route (/api/generate-art) to generate character portrait
     */
    const handleGenerateArt = async () => {
        setIsGenerating(true);
        setErrorMsg(null);

        try {
            const response = await fetch('/api/generate-art', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    characterName: character.name,
                    prompt: character.appearanceDescription,
                }),
            });

            if (!response.ok) {
                throw new Error('Failed to generate portrait');
            }

            const data = await response.json();
            setAvatarUrl(data.url);
        } catch (err) {
            setErrorMsg('Could not summon portrait. Try again!');
            console.error(err);
        } finally {
            setIsGenerating(false);
        }
    };

    const statEntries = Object.entries(character.stats) as [keyof typeof character.stats, number][];

    return (
        <div className="max-w-md w-full bg-slate-900 border border-slate-800 rounded-xl p-6 text-slate-100 shadow-xl space-y-6">

            {/* HEADER SECTION */}
            <div className="flex justify-between items-start border-b border-slate-800 pb-4">
                <div>
                    <h2 className="text-2xl font-bold text-amber-500">{character.name}</h2>
                    <p className="text-sm text-slate-400">
                        Level {character.level} • {character.characterClass}
                    </p>
                </div>

                {/* HP Tracker */}
                <div className="text-right">
                    <p className="text-xs uppercase tracking-wider text-slate-400 font-medium">Hit Points</p>
                    <p className="text-lg font-semibold text-emerald-400">
                        {hp} / {character.maxHp} HP
                    </p>
                    <div className="flex gap-1 mt-1 justify-end">
                        <button
                            onClick={() => handleHpChange(-1)}
                            aria-label="Decrease HP"
                            className="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-xs rounded border border-slate-700 transition"
                        >
                            -1
                        </button>
                        <button
                            onClick={() => handleHpChange(1)}
                            aria-label="Increase HP"
                            className="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 text-xs rounded border border-slate-700 transition"
                        >
                            +1
                        </button>
                    </div>
                </div>
            </div>

            {/* PORTRAIT & AI GENERATOR SECTION */}
            <div className="flex flex-col items-center gap-3 bg-slate-950 p-4 rounded-lg border border-slate-800">
                <div className="w-40 h-40 bg-slate-900 border border-slate-800 rounded-lg overflow-hidden flex items-center justify-center text-center p-2 relative">
                    {isGenerating ? (
                        <div className="flex flex-col items-center gap-2">
                            <span className="w-6 h-6 border-2 border-amber-500 border-t-transparent rounded-full animate-spin"></span>
                            <span className="text-xs text-amber-500 animate-pulse">Weaving Arcana...</span>
                        </div>
                    ) : avatarUrl ? (
                        <img
                            src={avatarUrl}
                            alt={character.name}
                            className="w-full h-full object-cover transition-opacity duration-300"
                        />
                    ) : (
                        <span className="text-xs text-slate-500">No Portrait Generated</span>
                    )}
                </div>

                <button
                    onClick={handleGenerateArt}
                    disabled={isGenerating}
                    className="w-full py-2 px-4 bg-amber-600 hover:bg-amber-500 disabled:bg-slate-800 text-white font-semibold text-xs rounded-md transition shadow-md flex items-center justify-center gap-2"
                >
                    {isGenerating ? 'Summoning...' : '✨ Generate AI Portrait'}
                </button>

                {errorMsg && <p className="text-[11px] text-rose-400">{errorMsg}</p>}
            </div>

            {/* VISUAL TRAITS SECTION */}
            <div>
                <h3 className="text-xs uppercase tracking-wider text-slate-400 mb-1 font-semibold">
                    Visual Traits
                </h3>
                <p className="text-xs text-slate-300 italic bg-slate-950 p-3 rounded-lg border border-slate-800/60 leading-relaxed">
                    "{character.appearanceDescription}"
                </p>
            </div>

            {/* ABILITY SCORES GRID */}
            <div>
                <h3 className="text-xs uppercase tracking-wider text-slate-400 mb-2 font-semibold">
                    Ability Scores
                </h3>
                <div className="grid grid-cols-3 gap-3">
                    {statEntries.map(([statName, score]) => (
                        <div
                            key={statName}
                            className="bg-slate-950 border border-slate-800 rounded-lg p-2 text-center flex flex-col justify-between"
                        >
                            <span className="block text-[10px] uppercase font-bold text-slate-400">
                                {statName.slice(0, 3)}
                            </span>
                            <span className="text-lg font-bold text-white">{score}</span>
                            <span className="block text-xs font-semibold text-amber-500">
                                {formatModifier(calculateModifier(score))}
                            </span>
                        </div>
                    ))}
                </div>
            </div>

            {/* INVENTORY LIST */}
            <div>
                <h3 className="text-xs uppercase tracking-wider text-slate-400 mb-2 font-semibold">
                    Inventory
                </h3>
                <div className="flex flex-wrap gap-1.5">
                    {character.inventory.map((item, idx) => (
                        <span
                            key={idx}
                            className="text-xs bg-slate-800 border border-slate-700/80 px-2.5 py-1 rounded-full text-slate-300"
                        >
                            {item}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    );
}