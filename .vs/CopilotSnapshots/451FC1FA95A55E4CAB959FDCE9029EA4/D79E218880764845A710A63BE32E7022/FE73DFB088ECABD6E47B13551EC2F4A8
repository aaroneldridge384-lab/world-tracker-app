/**
 * @file CharacterWizard.tsx
 * @description Step-by-step creation wizard for comprehensive D&D 5e character creation.
 */

'use client';

import { useState } from 'react';
import { CharacterSheet, AbilityName, Alignment } from '@/types/campaign';
import { DEFAULT_SKILLS, calculateModifier, calculateProficiencyBonus, formatModifier } from '@/utils/dnd';

interface Props {
    onCharacterCreated: (newCharacter: CharacterSheet) => void;
    onCancel: () => void;
}

const RACES = ['Wood Elf', 'High Elf', 'Mountain Dwarf', 'Human', 'Tiefling', 'Halfling', 'Dragonborn', 'Half-Orc'];
const CLASSES = ['Druid', 'Rogue', 'Wizard', 'Fighter', 'Cleric', 'Paladin', 'Bard', 'Warlock', 'Barbarian', 'Ranger'];
const BACKGROUNDS = ['Acolyte', 'Criminal', 'Folk Hero', 'Noble', 'Sage', 'Soldier', 'Outlander'];
const ALIGNMENTS: Alignment[] = ['LG', 'NG', 'CG', 'LN', 'TN', 'CN', 'LE', 'NE', 'CE'];

export default function CharacterWizard({ onCharacterCreated, onCancel }: Props) {
    const [step, setStep] = useState<number>(1);

    // Form State
    const [name, setName] = useState('');
    const [race, setRace] = useState(RACES[0]);
    const [characterClass, setCharacterClass] = useState(CLASSES[0]);
    const [background, setBackground] = useState(BACKGROUNDS[0]);
    const [alignment, setAlignment] = useState<Alignment>('NG');
    const [level, setLevel] = useState(1);
    const [maxHp, setMaxHp] = useState(10);
    const [armorClass, setArmorClass] = useState(14);

    const [stats, setStats] = useState<Record<AbilityName, number>>({
        strength: 10,
        dexterity: 14,
        constitution: 12,
        intelligence: 10,
        wisdom: 16,
        charisma: 8,
    });

    const [proficientSkills, setProficientSkills] = useState<Record<string, boolean>>({
        Perception: true,
        Survival: true,
    });

    const [feats, setFeats] = useState<string>('War Caster');
    const [spells, setSpells] = useState<string>('Guidance, Entangle, Cure Wounds');
    const [inventory, setInventory] = useState<string>('Quarterstaff, Leather Armor, Herbalism Kit');
    const [appearanceDescription, setAppearanceDescription] = useState('');

    const proficiencyBonus = calculateProficiencyBonus(level);

    const toggleSkill = (skillName: string) => {
        setProficientSkills((prev) => ({ ...prev, [skillName]: !prev[skillName] }));
    };

    const handleStatChange = (stat: AbilityName, val: number) => {
        setStats((prev) => ({ ...prev, [stat]: Math.max(1, Math.min(30, val)) }));
    };

    const handleFinish = (e: React.FormEvent) => {
        e.preventDefault();
        if (!name.trim()) return;

        const newCharacter: CharacterSheet = {
            id: `char-${Date.now()}`,
            name,
            race,
            characterClass,
            background,
            alignment,
            level,
            proficiencyBonus,
            stats,
            skills: DEFAULT_SKILLS.map((s) => ({
                ...s,
                isProficient: !!proficientSkills[s.name],
            })),
            feats: feats.split(',').map((f) => f.trim()).filter(Boolean),
            spells: spells.split(',').map((s) => s.trim()).filter(Boolean),
            currentHp: maxHp,
            maxHp,
            armorClass,
            inventory: inventory.split(',').map((i) => i.trim()).filter(Boolean),
            appearanceDescription: appearanceDescription || `${race} ${characterClass} with a distinctive adventurer presence.`,
        };

        onCharacterCreated(newCharacter);
    };

    return (
        <div className="max-w-2xl w-full bg-slate-900 border border-slate-800 rounded-2xl p-6 text-slate-100 shadow-2xl space-y-6">
            {/* Progress Header */}
            <div className="border-b border-slate-800 pb-4">
                <div className="flex justify-between items-center mb-2">
                    <h2 className="text-xl font-bold text-amber-500">Character Creation Wizard</h2>
                    <span className="text-xs font-semibold text-slate-400">Step {step} of 4</span>
                </div>
                <div className="w-full bg-slate-950 h-2 rounded-full overflow-hidden border border-slate-800">
                    <div
                        className="bg-amber-500 h-full transition-all duration-300"
                        style={{ width: `${(step / 4) * 100}%` }}
                    />
                </div>
            </div>

            <form onSubmit={step === 4 ? handleFinish : (e) => { e.preventDefault(); setStep(step + 1); }}>
                {/* STEP 1: Core Profile */}
                {step === 1 && (
                    <div className="space-y-4">
                        <h3 className="text-sm font-bold uppercase tracking-wider text-slate-300">1. Identity & Ancestry</h3>
                        <div>
                            <label className="block text-xs text-slate-400 mb-1">Character Name</label>
                            <input
                                type="text"
                                required
                                value={name}
                                onChange={(e) => setName(e.target.value)}
                                placeholder="e.g., Thalia Sunseeker"
                                className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                            />
                        </div>

                        <div className="grid grid-cols-2 gap-3">
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Race / Ancestry</label>
                                <select
                                    value={race}
                                    onChange={(e) => setRace(e.target.value)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                                >
                                    {RACES.map((r) => (<option key={r} value={r}>{r}</option>))}
                                </select>
                            </div>

                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Background</label>
                                <select
                                    value={background}
                                    onChange={(e) => setBackground(e.target.value)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                                >
                                    {BACKGROUNDS.map((b) => (<option key={b} value={b}>{b}</option>))}
                                </select>
                            </div>
                        </div>

                        <div className="grid grid-cols-2 gap-3">
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Alignment</label>
                                <select
                                    value={alignment}
                                    onChange={(e) => setAlignment(e.target.value as Alignment)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                                >
                                    {ALIGNMENTS.map((a) => (<option key={a} value={a}>{a}</option>))}
                                </select>
                            </div>

                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Starting Level</label>
                                <input
                                    type="number"
                                    min="1"
                                    max="20"
                                    value={level}
                                    onChange={(e) => setLevel(Number(e.target.value))}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-amber-500"
                                />
                            </div>
                        </div>
                    </div>
                )}

                {/* STEP 2: Class & Stats */}
                {step === 2 && (
                    <div className="space-y-4">
                        <h3 className="text-sm font-bold uppercase tracking-wider text-slate-300">2. Class & Ability Scores</h3>
                        <div className="grid grid-cols-3 gap-3">
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Class</label>
                                <select
                                    value={characterClass}
                                    onChange={(e) => setCharacterClass(e.target.value)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-sm text-white"
                                >
                                    {CLASSES.map((c) => (<option key={c} value={c}>{c}</option>))}
                                </select>
                            </div>
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Max HP</label>
                                <input
                                    type="number"
                                    min="1"
                                    value={maxHp}
                                    onChange={(e) => setMaxHp(Number(e.target.value))}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-sm text-white text-center"
                                />
                            </div>
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Armor Class (AC)</label>
                                <input
                                    type="number"
                                    min="1"
                                    value={armorClass}
                                    onChange={(e) => setArmorClass(Number(e.target.value))}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-sm text-white text-center"
                                />
                            </div>
                        </div>

                        <div>
                            <label className="block text-xs text-slate-400 mb-2">Ability Scores (Modifiers Auto-Calculate)</label>
                            <div className="grid grid-cols-3 gap-3">
                                {(Object.keys(stats) as AbilityName[]).map((st) => (
                                    <div key={st} className="bg-slate-950 border border-slate-800 rounded-lg p-2 text-center">
                                        <span className="block text-[10px] uppercase font-bold text-slate-400">{st.slice(0, 3)}</span>
                                        <input
                                            type="number"
                                            min="1"
                                            max="30"
                                            value={stats[st]}
                                            onChange={(e) => handleStatChange(st, Number(e.target.value))}
                                            className="w-full bg-slate-900 border border-slate-700 rounded text-center text-sm font-bold text-white p-1 my-1"
                                        />
                                        <span className="text-xs font-bold text-amber-500">
                                            {formatModifier(calculateModifier(stats[st]))}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                )}

                {/* STEP 3: Skills & Feats */}
                {step === 3 && (
                    <div className="space-y-4">
                        <div className="flex justify-between items-center">
                            <h3 className="text-sm font-bold uppercase tracking-wider text-slate-300">3. Skills & Feats</h3>
                            <span className="text-xs text-amber-500">Proficiency Bonus: +{proficiencyBonus}</span>
                        </div>

                        <div>
                            <label className="block text-xs text-slate-400 mb-2">Select Skill Proficiencies</label>
                            <div className="grid grid-cols-2 gap-2 max-h-48 overflow-y-auto pr-1">
                                {DEFAULT_SKILLS.map((sk) => (
                                    <label
                                        key={sk.name}
                                        className={`flex items-center justify-between p-2 rounded-lg border text-xs cursor-pointer transition ${proficientSkills[sk.name]
                                                ? 'bg-amber-950/40 border-amber-600/60 text-white'
                                                : 'bg-slate-950 border-slate-800 text-slate-400'
                                            }`}
                                    >
                                        <span>{sk.name} <span className="text-[10px] text-slate-500">({sk.ability.slice(0, 3)})</span></span>
                                        <input
                                            type="checkbox"
                                            checked={!!proficientSkills[sk.name]}
                                            onChange={() => toggleSkill(sk.name)}
                                            className="accent-amber-500"
                                        />
                                    </label>
                                ))}
                            </div>
                        </div>

                        <div className="grid grid-cols-2 gap-3">
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Feats (Comma separated)</label>
                                <input
                                    type="text"
                                    value={feats}
                                    onChange={(e) => setFeats(e.target.value)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white"
                                />
                            </div>
                            <div>
                                <label className="block text-xs text-slate-400 mb-1">Spells (Comma separated)</label>
                                <input
                                    type="text"
                                    value={spells}
                                    onChange={(e) => setSpells(e.target.value)}
                                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-white"
                                />
                            </div>
                        </div>
                    </div>
                )}

                {/* STEP 4: Equipment & Visual Description */}
                {step === 4 && (
                    <div className="space-y-4">
                        <h3 className="text-sm font-bold uppercase tracking-wider text-slate-300">4. Inventory & Visual Traits</h3>
                        <div>
                            <label className="block text-xs text-slate-400 mb-1">Starting Inventory (Comma separated)</label>
                            <input
                                type="text"
                                value={inventory}
                                onChange={(e) => setInventory(e.target.value)}
                                className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white"
                            />
                        </div>

                        <div>
                            <label className="block text-xs text-slate-400 mb-1">Visual Traits (Feeds AI Generator)</label>
                            <textarea
                                rows={3}
                                value={appearanceDescription}
                                onChange={(e) => setAppearanceDescription(e.target.value)}
                                placeholder="Detailed description of attire, eyes, hair, armor, weapons..."
                                className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2.5 text-xs text-white resize-none"
                            />
                        </div>
                    </div>
                )}

                {/* WIZARD CONTROLS */}
                <div className="flex justify-between items-center pt-4 border-t border-slate-800 mt-6">
                    <button
                        type="button"
                        onClick={step === 1 ? onCancel : () => setStep(step - 1)}
                        className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 font-semibold rounded-lg transition"
                    >
                        {step === 1 ? 'Cancel' : '← Back'}
                    </button>

                    <button
                        type="submit"
                        className="px-5 py-2 bg-amber-600 hover:bg-amber-500 text-xs text-white font-semibold rounded-lg transition shadow-md"
                    >
                        {step === 4 ? '✨ Forge Character Sheet' : 'Next Step →'}
                    </button>
                </div>
            </form>
        </div>
    );
}