/**
 * @file dnd.ts
 * @description Rules engine helper functions for D&D 5e calculations.
 */

import { AbilityName } from '@/types/campaign';

/**
 * Calculates a D&D 5e Ability Score Modifier.
 * Formula: floor((Score - 10) / 2)
 */
export function calculateModifier(statValue: number): number {
    return Math.floor((statValue - 10) / 2);
}

/**
 * Formats a raw numerical modifier with explicit + or - sign.
 */
export function formatModifier(mod: number): string {
    return mod >= 0 ? `+${mod}` : `${mod}`;
}

/**
 * Derives 5e Proficiency Bonus based on character level.
 */
export function calculateProficiencyBonus(level: number): number {
    return Math.ceil(1 + level / 4);
}

/**
 * Calculates total skill check bonus:
 * Ability Modifier + (Proficiency Bonus if proficient)
 */
export function calculateSkillBonus(
    statValue: number,
    isProficient: boolean,
    proficiencyBonus: number
): number {
    const mod = calculateModifier(statValue);
    return isProficient ? mod + proficiencyBonus : mod;
}

