'use client';

import { useEffect, useRef, useState, type PointerEvent } from 'react';
import type { CampaignMap, CanvasPoint, MapDrawing, MapPin, MapPinKind, MapTool, StoryNode } from '@/types/campaign';

interface Props {
    map: CampaignMap;
    storyNodes: StoryNode[];
    onChange: (map: CampaignMap) => void;
}

const PIN_ICONS: Record<MapPinKind, string> = {
    encounter: '⚔️',
    trap: '⚠️',
    loot: '💰',
    secret: '❓',
    note: '📍',
};

function distanceToSegment(point: CanvasPoint, start: CanvasPoint, end: CanvasPoint) {
    const dx = end.x - start.x;
    const dy = end.y - start.y;
    const lengthSquared = dx * dx + dy * dy;
    const ratio = lengthSquared === 0
        ? 0
        : Math.max(0, Math.min(1, ((point.x - start.x) * dx + (point.y - start.y) * dy) / lengthSquared));
    return Math.hypot(point.x - (start.x + ratio * dx), point.y - (start.y + ratio * dy));
}

function segmentsFor(drawing: MapDrawing): [CanvasPoint, CanvasPoint][] {
    if (drawing.type === 'rectangle' && drawing.points.length >= 2) {
        const [start, end] = drawing.points;
        const corners = [
            start,
            { x: end.x, y: start.y },
            end,
            { x: start.x, y: end.y },
            start,
        ];
        return corners.slice(1).map((point, index) => [corners[index], point]);
    }

    return drawing.points.slice(1).map((point, index) => [drawing.points[index], point]);
}

export default function MapCanvas({ map, storyNodes, onChange }: Props) {
    const canvasRef = useRef<HTMLCanvasElement>(null);
    const activeDrawingRef = useRef<MapDrawing | null>(null);
    const [activeDrawing, setActiveDrawing] = useState<MapDrawing | null>(null);
    const [tool, setTool] = useState<MapTool>('brush');
    const [pinKind, setPinKind] = useState<MapPinKind>('encounter');
    const [brushColor, setBrushColor] = useState('#f59e0b');
    const [brushWidth, setBrushWidth] = useState(4);
    const [eraserMode, setEraserMode] = useState<'point' | 'object'>('point');
    const [selectedPinId, setSelectedPinId] = useState<string | null>(null);
    const [isDraggingPin, setIsDraggingPin] = useState(false);
    const [canvasError, setCanvasError] = useState<string | null>(null);

    const selectedPin = map.pins.find((pin) => pin.id === selectedPinId) ?? null;

    useEffect(() => {
        const canvas = canvasRef.current;
        const context = canvas?.getContext('2d');
        if (!canvas || !context) return;

        const render = () => {
            context.clearRect(0, 0, map.width, map.height);
            context.fillStyle = '#020617';
            context.fillRect(0, 0, map.width, map.height);

            if (map.backgroundImage) {
                const image = new Image();
                image.onload = () => {
                    context.drawImage(image, 0, 0, map.width, map.height);
                    renderOverlay();
                };
                image.src = map.backgroundImage;
            } else {
                renderOverlay();
            }
        };

        const renderOverlay = () => {
            if (map.gridVisible) {
                context.save();
                context.globalAlpha = map.gridOpacity;
                context.strokeStyle = '#cbd5e1';
                context.lineWidth = 1;
                context.beginPath();
                for (let x = 0; x <= map.width; x += map.gridSize) {
                    context.moveTo(x, 0);
                    context.lineTo(x, map.height);
                }
                for (let y = 0; y <= map.height; y += map.gridSize) {
                    context.moveTo(0, y);
                    context.lineTo(map.width, y);
                }
                context.stroke();
                context.restore();
            }

            [...map.drawings, ...(activeDrawing ? [activeDrawing] : [])].forEach((drawing) => drawShape(context, drawing));
            map.pins.forEach((pin) => {
                context.font = '22px sans-serif';
                context.textAlign = 'center';
                context.textBaseline = 'middle';
                context.fillText(PIN_ICONS[pin.kind], pin.x, pin.y);
            });
        };

        render();
    }, [map, activeDrawing]);

    const drawShape = (context: CanvasRenderingContext2D, drawing: MapDrawing) => {
        if (drawing.points.length === 0 || drawing.type === 'eraser') return;
        const [start] = drawing.points;
        const end = drawing.points[drawing.points.length - 1];
        context.save();
        context.strokeStyle = drawing.color;
        context.lineWidth = drawing.width;
        context.lineCap = 'round';
        context.lineJoin = 'round';
        context.beginPath();

        if (drawing.type === 'brush' || drawing.type === 'line') {
            context.moveTo(start.x, start.y);
            drawing.points.slice(1).forEach((point) => context.lineTo(point.x, point.y));
        } else if (drawing.type === 'rectangle') {
            context.rect(start.x, start.y, end.x - start.x, end.y - start.y);
        } else if (drawing.type === 'circle') {
            context.arc(start.x, start.y, Math.hypot(end.x - start.x, end.y - start.y), 0, Math.PI * 2);
        }

        context.stroke();
        context.restore();
    };

    const pointFromEvent = (event: PointerEvent<HTMLCanvasElement>): CanvasPoint => {
        const bounds = event.currentTarget.getBoundingClientRect();
        let x = (event.clientX - bounds.left) * (map.width / bounds.width);
        let y = (event.clientY - bounds.top) * (map.height / bounds.height);
        if (map.snapToGrid) {
            x = Math.round(x / map.gridSize) * map.gridSize;
            y = Math.round(y / map.gridSize) * map.gridSize;
        }
        return {
            x: Math.max(0, Math.min(map.width, x)),
            y: Math.max(0, Math.min(map.height, y)),
        };
    };

    const eraseAt = (point: CanvasPoint) => {
        const near = (drawing: MapDrawing) => segmentsFor(drawing).some(([start, end]) =>
            distanceToSegment(point, start, end) <= Math.max(12, drawing.width + 6)
        );

        if (eraserMode === 'object') {
            onChange({ ...map, drawings: map.drawings.filter((drawing) => !near(drawing)) });
            return;
        }

        const kept: MapDrawing[] = [];
        map.drawings.forEach((drawing) => {
            if (drawing.type !== 'brush') {
                if (!near(drawing)) kept.push(drawing);
                return;
            }

            let remaining: CanvasPoint[] = [];
            const flush = () => {
                if (remaining.length > 1) kept.push({ ...drawing, id: crypto.randomUUID(), points: remaining });
                remaining = [];
            };
            drawing.points.forEach((drawingPoint) => {
                if (Math.hypot(point.x - drawingPoint.x, point.y - drawingPoint.y) <= Math.max(12, drawing.width + 6)) {
                    flush();
                } else {
                    remaining.push(drawingPoint);
                }
            });
            flush();
        });
        onChange({ ...map, drawings: kept });
    };

    const handlePointerDown = (event: PointerEvent<HTMLCanvasElement>) => {
        if (tool === 'pin') {
            const point = pointFromEvent(event);
            const pin: MapPin = {
                id: crypto.randomUUID(),
                x: point.x,
                y: point.y,
                kind: pinKind,
                title: `New ${pinKind}`,
                note: '',
            };
            onChange({ ...map, pins: [...map.pins, pin] });
            setSelectedPinId(pin.id);
            return;
        }

        const point = pointFromEvent(event);
        if (tool === 'eraser') {
            eraseAt(point);
            return;
        }

        event.currentTarget.setPointerCapture(event.pointerId);
        const drawing: MapDrawing = {
            id: crypto.randomUUID(),
            type: tool,
            points: [point],
            color: brushColor,
            width: brushWidth,
        };
        activeDrawingRef.current = drawing;
        setActiveDrawing(drawing);
    };

    const handlePointerMove = (event: PointerEvent<HTMLCanvasElement>) => {
        if (tool === 'eraser' && event.buttons > 0) {
            eraseAt(pointFromEvent(event));
            return;
        }
        const current = activeDrawingRef.current;
        if (!current) return;
        const next = { ...current, points: [...current.points, pointFromEvent(event)] };
        activeDrawingRef.current = next;
        setActiveDrawing(next);
    };

    const handlePointerUp = () => {
        const completed = activeDrawingRef.current;
        if (completed) onChange({ ...map, drawings: [...map.drawings, completed] });
        activeDrawingRef.current = null;
        setActiveDrawing(null);
    };

    const updatePin = (id: string, patch: Partial<MapPin>) => {
        onChange({ ...map, pins: map.pins.map((pin) => pin.id === id ? { ...pin, ...patch } : pin) });
    };

    const handlePinPointerDown = (event: PointerEvent<HTMLButtonElement>, pin: MapPin) => {
        event.stopPropagation();
        event.currentTarget.setPointerCapture(event.pointerId);
        setSelectedPinId(pin.id);
        setIsDraggingPin(true);
    };

    const handlePinPointerMove = (event: PointerEvent<HTMLButtonElement>, pin: MapPin) => {
        if (!isDraggingPin) return;
        const bounds = event.currentTarget.parentElement?.getBoundingClientRect();
        if (!bounds) return;
        let x = (event.clientX - bounds.left) * (map.width / bounds.width);
        let y = (event.clientY - bounds.top) * (map.height / bounds.height);
        if (map.snapToGrid) {
            x = Math.round(x / map.gridSize) * map.gridSize;
            y = Math.round(y / map.gridSize) * map.gridSize;
        }
        updatePin(pin.id, {
            x: Math.max(0, Math.min(map.width, x)),
            y: Math.max(0, Math.min(map.height, y)),
        });
    };

    const importBackground = (file?: File) => {
        if (!file) return;
        setCanvasError(null);
        const objectUrl = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
            const scale = Math.min(1, 1600 / image.naturalWidth, 1600 / image.naturalHeight);
            const importCanvas = document.createElement('canvas');
            importCanvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
            importCanvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
            const context = importCanvas.getContext('2d');
            if (!context) {
                setCanvasError('Could not import that image.');
                URL.revokeObjectURL(objectUrl);
                return;
            }
            context.drawImage(image, 0, 0, importCanvas.width, importCanvas.height);
            onChange({ ...map, backgroundImage: importCanvas.toDataURL('image/jpeg', 0.8) });
            URL.revokeObjectURL(objectUrl);
        };
        image.onerror = () => {
            setCanvasError('Could not read that image.');
            URL.revokeObjectURL(objectUrl);
        };
        image.src = objectUrl;
    };

    const exportPng = () => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        const link = document.createElement('a');
        link.download = `${map.name.trim() || 'campaign-map'}.png`;
        link.href = canvas.toDataURL('image/png');
        link.click();
    };

    const toolButton = (value: MapTool, label: string) => (
        <button
            key={value}
            type="button"
            onClick={() => setTool(value)}
            aria-pressed={tool === value}
            className={`rounded-lg border px-3 py-2 font-sans text-xs font-semibold transition ${tool === value ? 'border-amber-200/30 bg-amber-400/15 text-amber-200 shadow-[inset_0_0_18px_rgba(214,168,79,0.12)]' : 'border-slate-700/70 bg-slate-800/70 text-slate-300 hover:border-amber-200/20 hover:text-amber-100'}`}
        >
            {label}
        </button>
    );

    return (
        <div className="space-y-4">
            <section className="fantasy-panel flex flex-wrap items-center gap-2 rounded-xl p-3">
                {toolButton('brush', 'Brush')}
                {toolButton('rectangle', 'Rectangle')}
                {toolButton('circle', 'Circle')}
                {toolButton('line', 'Line')}
                {toolButton('eraser', 'Eraser')}
                {toolButton('pin', 'Place Pin')}
                <label className="ml-1 flex items-center gap-2 text-xs text-slate-300">
                    Color
                    <input type="color" aria-label="Brush color" value={brushColor} onChange={(event) => setBrushColor(event.target.value)} className="h-8 w-10 rounded bg-transparent" />
                </label>
                <label className="flex items-center gap-2 text-xs text-slate-300">
                    Width
                    <input type="range" aria-label="Brush width" min="1" max="24" value={brushWidth} onChange={(event) => setBrushWidth(Number(event.target.value))} />
                </label>
                <label className="flex items-center gap-2 text-xs text-slate-300">
                    Pin
                    <select value={pinKind} onChange={(event) => setPinKind(event.target.value as MapPinKind)} className="rounded-lg border border-slate-700 bg-[#090c12] px-2 py-1">
                        {Object.keys(PIN_ICONS).map((kind) => <option key={kind} value={kind}>{kind}</option>)}
                    </select>
                </label>
            </section>

            <section className="fantasy-panel flex flex-wrap items-center gap-4 rounded-xl p-3 font-sans text-xs text-slate-300">
                <label className="flex items-center gap-2"><input type="checkbox" checked={map.gridVisible} onChange={(event) => onChange({ ...map, gridVisible: event.target.checked })} />Grid</label>
                <label className="flex items-center gap-2">Grid opacity<input type="range" aria-label="Grid opacity" min="0.05" max="0.8" step="0.05" value={map.gridOpacity} onChange={(event) => onChange({ ...map, gridOpacity: Number(event.target.value) })} /></label>
                <label className="flex items-center gap-2">Cell size<input type="number" min="10" max="100" value={map.gridSize} onChange={(event) => onChange({ ...map, gridSize: Math.max(10, Number(event.target.value)) })} className="w-16 rounded-lg border border-slate-700 bg-[#090c12] px-2 py-1" /></label>
                <label className="flex items-center gap-2"><input type="checkbox" checked={map.snapToGrid} onChange={(event) => onChange({ ...map, snapToGrid: event.target.checked })} />Snap to grid</label>
                <label className="flex items-center gap-2">Eraser mode<select value={eraserMode} onChange={(event) => setEraserMode(event.target.value as 'point' | 'object')} className="rounded-lg border border-slate-700 bg-[#090c12] px-2 py-1"><option value="point">Point</option><option value="object">Object</option></select></label>
                <label className="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 bg-slate-800/70 px-3 py-2 transition hover:border-amber-300/30 hover:text-amber-100 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-amber-300">Import background<input type="file" accept="image/*" aria-label="Import map background image" onChange={(event) => importBackground(event.target.files?.[0])} className="sr-only" /></label>
                <button type="button" onClick={() => onChange({ ...map, backgroundImage: undefined })} className="rounded-lg border border-slate-700 bg-slate-800/70 px-3 py-2 transition hover:border-amber-300/30">Clear background</button>
                <button type="button" onClick={exportPng} className="rounded-lg bg-gradient-to-r from-amber-700 to-amber-500 px-3 py-2 font-semibold text-[#17120a] shadow-lg shadow-amber-950/30 transition hover:brightness-110">Export PNG</button>
            </section>

            {canvasError && <p role="alert" className="text-sm text-rose-300">{canvasError}</p>}
            <div className="relative mx-auto w-full overflow-hidden rounded-2xl border border-amber-200/15 bg-[#090c12] shadow-[0_20px_60px_rgba(0,0,0,0.5)]" style={{ maxWidth: map.width, aspectRatio: `${map.width} / ${map.height}` }}>
                <canvas
                    ref={canvasRef}
                    width={map.width}
                    height={map.height}
                    onPointerDown={handlePointerDown}
                    onPointerMove={handlePointerMove}
                    onPointerUp={handlePointerUp}
                    onPointerCancel={handlePointerUp}
                    className="absolute inset-0 h-full w-full touch-none"
                    aria-label="Interactive campaign map canvas"
                />
                {map.pins.map((pin) => (
                    <button
                        key={pin.id}
                        type="button"
                        title={`${pin.title}${pin.note ? `: ${pin.note}` : ''}`}
                        aria-label={`Edit ${pin.kind} pin ${pin.title}`}
                        onClick={() => setSelectedPinId(pin.id)}
                        onPointerDown={(event) => handlePinPointerDown(event, pin)}
                        onPointerMove={(event) => handlePinPointerMove(event, pin)}
                        onPointerUp={() => setIsDraggingPin(false)}
                        className="absolute flex h-8 w-8 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-amber-300 bg-[#090c12]/90 text-base shadow-[0_0_16px_rgba(214,168,79,0.2)] transition hover:scale-110 hover:bg-amber-400/20"
                        style={{ left: `${pin.x / map.width * 100}%`, top: `${pin.y / map.height * 100}%` }}
                    >
                        {PIN_ICONS[pin.kind]}
                    </button>
                ))}
            </div>

            {selectedPin && (
                <section className="fantasy-panel grid gap-3 rounded-xl p-4 md:grid-cols-2">
                    <label className="space-y-1 font-sans text-xs text-slate-400">Pin title<input value={selectedPin.title} onChange={(event) => updatePin(selectedPin.id, { title: event.target.value })} className="w-full rounded-lg border border-slate-700 bg-[#090c12] p-2 font-sans text-sm text-white" /></label>
                    <label className="space-y-1 font-sans text-xs text-slate-400">Link to story node<select value={selectedPin.storyNodeId ?? ''} onChange={(event) => updatePin(selectedPin.id, { storyNodeId: event.target.value || undefined })} className="w-full rounded-lg border border-slate-700 bg-[#090c12] p-2 font-sans text-sm text-white"><option value="">No link</option>{storyNodes.map((node) => <option key={node.id} value={node.id}>{node.title}</option>)}</select></label>
                    <label className="space-y-1 font-sans text-xs text-slate-400 md:col-span-2">Pin note<textarea value={selectedPin.note} onChange={(event) => updatePin(selectedPin.id, { note: event.target.value })} rows={2} className="w-full rounded-lg border border-slate-700 bg-[#090c12] p-2 font-sans text-sm text-white" /></label>
                    <div className="flex gap-2 md:col-span-2">
                        <button type="button" onClick={() => setSelectedPinId(null)} className="rounded-lg border border-slate-700 bg-slate-800/80 px-3 py-2 font-sans text-xs text-white transition hover:border-amber-300/30">Close</button>
                        <button type="button" onClick={() => { onChange({ ...map, pins: map.pins.filter((pin) => pin.id !== selectedPin.id) }); setSelectedPinId(null); }} className="rounded-lg border border-rose-800 bg-rose-950/70 px-3 py-2 font-sans text-xs text-rose-200 transition hover:bg-rose-900">Delete Pin</button>
                    </div>
                </section>
            )}
        </div>
    );
}
