'use client';

import { useState, type FormEvent } from 'react';
import Link from 'next/link';
import { INITIAL_LOCATIONS } from '@/data/mockCampaign';
import { useLocalStorage } from '@/hooks/useLocalStorage';
import type { Location, StoryNode } from '@/types/campaign';

const EMPTY_STORY_NODES: StoryNode[] = [];
const LOCATION_TYPES: Location['type'][] = ['Continent', 'Kingdom', 'Town', 'Dungeon'];

export default function LocationsPage() {
    const [locations, setLocations, isLoaded, storageError] = useLocalStorage('dnd-locations', INITIAL_LOCATIONS);
    const [storyNodes, , storyLoaded] = useLocalStorage('dnd-story-nodes', EMPTY_STORY_NODES);
    const [generatingId, setGeneratingId] = useState<string | null>(null);
    const [artError, setArtError] = useState<string | null>(null);
    const [name, setName] = useState('');
    const [type, setType] = useState<Location['type']>('Town');
    const [summary, setSummary] = useState('');
    const [features, setFeatures] = useState('');

    const addLocation = (event: FormEvent) => {
        event.preventDefault();
        if (!name.trim()) return;
        const location: Location = {
            id: crypto.randomUUID(),
            name: name.trim(),
            type,
            summary: summary.trim(),
            notableFeatures: features.split(',').map((feature) => feature.trim()).filter(Boolean),
        };
        setLocations((current) => [location, ...current]);
        setName('');
        setSummary('');
        setFeatures('');
    };

    const updateLocation = (location: Location, patch: Partial<Location>) => {
        setLocations((current) => current.map((item) => item.id === location.id ? { ...item, ...patch } : item));
    };

    const generateLandscape = async (location: Location) => {
        setGeneratingId(location.id);
        setArtError(null);
        try {
            const response = await fetch('/api/generate-art', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ characterName: location.name, prompt: location.summary || location.notableFeatures.join(', ') || location.type, kind: 'landscape' }),
            });
            if (!response.ok) throw new Error('Landscape generation failed');
            const data: { url?: string } = await response.json();
            if (!data.url) throw new Error('Landscape URL was not returned');
            updateLocation(location, { artworkUrl: data.url });
        } catch (error) {
            setArtError(`Could not generate artwork for ${location.name}.`);
            console.error(error);
        } finally {
            setGeneratingId(null);
        }
    };

    if (!isLoaded || !storyLoaded) return <p className="text-slate-400">Loading world directory…</p>;

    return (
        <main id="world-directory" className="space-y-6">
            <header className="fantasy-panel rounded-2xl p-6 sm:p-8">
                <p className="fantasy-kicker">Beyond the known road</p>
                <h1 className="fantasy-heading mt-2 text-3xl font-bold">World Directory</h1>
                <p className="mt-2 font-sans text-sm text-slate-400">Build a persistent gazetteer of regions, settlements, and dungeons.</p>
            </header>

            {storageError && <p role="alert" className="rounded-lg border border-rose-800 bg-rose-950/40 p-3 text-sm text-rose-200">{storageError}</p>}
            {artError && <p role="alert" className="rounded-lg border border-rose-800 bg-rose-950/40 p-3 text-sm text-rose-200">{artError}</p>}

            <form onSubmit={addLocation} className="fantasy-panel grid gap-3 rounded-xl p-4 md:grid-cols-2">
                <h2 className="fantasy-heading text-lg font-bold md:col-span-2">Add a Location</h2>
                <input value={name} onChange={(event) => setName(event.target.value)} placeholder="Name" required className="rounded-lg border border-slate-700 bg-[#090c12] p-2.5 font-sans text-sm text-white placeholder:text-slate-600" />
                <select value={type} onChange={(event) => setType(event.target.value as Location['type'])} className="rounded-lg border border-slate-700 bg-[#090c12] p-2.5 font-sans text-sm text-white">
                    {LOCATION_TYPES.map((item) => <option key={item} value={item}>{item}</option>)}
                </select>
                <textarea value={summary} onChange={(event) => setSummary(event.target.value)} placeholder="Description or campaign notes" rows={2} className="rounded-lg border border-slate-700 bg-[#090c12] p-2.5 font-sans text-sm text-white placeholder:text-slate-600 md:col-span-2" />
                <input value={features} onChange={(event) => setFeatures(event.target.value)} placeholder="Notable features, comma separated" className="rounded-lg border border-slate-700 bg-[#090c12] p-2.5 font-sans text-sm text-white placeholder:text-slate-600" />
                <button type="submit" className="rounded-lg bg-gradient-to-r from-amber-700 to-amber-500 px-4 py-2 font-sans text-sm font-bold text-[#17120a] shadow-lg shadow-amber-950/30 transition hover:brightness-110">＋ Add Location</button>
            </form>

            {locations.length === 0 ? (
                <p className="fantasy-panel rounded-xl p-8 text-center font-sans text-slate-400">No locations yet. Add one to begin your world directory.</p>
            ) : (
                <div className="grid gap-4 md:grid-cols-2">
                    {locations.map((location) => {
                        const linkedNode = storyNodes.find((node) => node.kind === 'Location' && node.linkedEntityId === location.id);
                        return (
                            <article id={location.id} key={location.id} className="fantasy-panel scroll-mt-6 space-y-3 rounded-xl p-5">
                                <div className="flex items-start justify-between gap-3">
                                    <div>
                                        <span className="text-[10px] uppercase tracking-wider text-amber-500">{location.type}</span>
                                        <h2 className="text-xl font-bold text-slate-100">{location.name}</h2>
                                    </div>
                                    <button type="button" onClick={() => setLocations((current) => current.filter((item) => item.id !== location.id))} className="text-xs text-rose-300 hover:text-rose-200">Delete</button>
                                </div>
                                <textarea aria-label={`Description of ${location.name}`} value={location.summary} onChange={(event) => updateLocation(location, { summary: event.target.value })} rows={3} className="w-full resize-y rounded-lg border border-slate-700 bg-[#090c12] p-3 font-sans text-sm text-slate-300" />
                                {location.artworkUrl && <img src={location.artworkUrl} alt={`${location.name} fantasy landscape`} className="max-h-72 w-full rounded-lg border border-slate-800 object-cover" />}
                                <button type="button" onClick={() => generateLandscape(location)} disabled={generatingId === location.id} className="rounded-lg bg-gradient-to-r from-amber-700 to-amber-500 px-3 py-2 font-sans text-xs font-bold text-[#17120a] shadow-lg shadow-amber-950/30 transition hover:brightness-110 disabled:cursor-wait disabled:opacity-50">
                                    {generatingId === location.id ? 'Weaving Arcana…' : location.artworkUrl ? 'Regenerate Landscape' : 'Generate AI Landscape'}
                                </button>
                                <div className="flex flex-wrap gap-1.5">
                                    {location.notableFeatures.map((feature) => <span key={feature} className="rounded-full border border-slate-700 bg-slate-800 px-2.5 py-1 text-[11px] text-slate-300">{feature}</span>)}
                                </div>
                                {linkedNode && <Link href={`/story#${linkedNode.id}`} className="inline-block text-xs text-sky-300 underline">Open story node: {linkedNode.title}</Link>}
                                <div className="flex flex-wrap gap-3">
                                    {linkedNode && <Link href={`/story#${linkedNode.id}`} className="text-xs text-emerald-300 underline">View in story graph</Link>}
                                    <button type="button" onClick={() => {
                                        const replacement = window.prompt('Notable features, separated by commas', location.notableFeatures.join(', '));
                                        if (replacement !== null) updateLocation(location, { notableFeatures: replacement.split(',').map((item) => item.trim()).filter(Boolean) });
                                    }} className="text-xs text-slate-400 underline">Edit features</button>
                                </div>
                            </article>
                        );
                    })}
                </div>
            )}
        </main>
    );
}
