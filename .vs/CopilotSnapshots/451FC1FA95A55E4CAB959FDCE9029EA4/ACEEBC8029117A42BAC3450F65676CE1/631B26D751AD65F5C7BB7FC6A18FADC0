'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';

const navigation = [
    { href: '/', label: 'Party Roster', icon: '♟' },
    { href: '/create', label: 'Character Creator', icon: '✦' },
    { href: '/maps', label: 'Map Studio', icon: '⌖' },
    { href: '/story', label: 'Story & Quests', icon: '❖' },
    { href: '/locations', label: 'World Directory', icon: '⌂' },
];

export default function PrimaryNavigation() {
    const pathname = usePathname();

    return (
        <nav aria-label="Main navigation" className="flex w-full gap-1 overflow-x-auto pb-1 text-sm sm:w-auto sm:pb-0">
            {navigation.map((item) => {
                const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
                return (
                    <Link
                        key={item.href}
                        href={item.href}
                        aria-current={active ? 'page' : undefined}
                        className={`flex shrink-0 items-center gap-2 rounded-lg border px-3 py-2 font-sans text-xs font-semibold transition sm:text-sm ${active ? 'border-amber-300/20 bg-amber-300/10 text-amber-200 shadow-[inset_0_1px_rgba(255,255,255,0.04)]' : 'border-transparent text-slate-400 hover:border-white/5 hover:bg-white/5 hover:text-[#f1e8d6]'}`}
                    >
                        <span aria-hidden="true" className="text-amber-400/80">{item.icon}</span>{item.label}
                    </Link>
                );
            })}
        </nav>
    );
}
