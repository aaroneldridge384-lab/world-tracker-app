/**
 * @file route.ts
 * @description Next.js Server Route Handler for generating character artwork.
 * Path: /api/generate-art
 */

import { NextResponse } from 'next/server';

export async function POST(request: Request) {
    let body: unknown;

    try {
        body = await request.json();
    } catch {
        return NextResponse.json({ error: 'Request body must be valid JSON.' }, { status: 400 });
    }

    if (typeof body !== 'object' || body === null) {
        return NextResponse.json({ error: 'Request body must be an object.' }, { status: 400 });
    }

    const { prompt, characterName } = body as Record<string, unknown>;
    if (typeof prompt !== 'string' || !prompt.trim() || typeof characterName !== 'string' || !characterName.trim()) {
        return NextResponse.json(
            { error: 'Character name and prompt description are required.' },
            { status: 400 }
        );
    }

    const fullPrompt = `dungeons and dragons portrait of ${characterName.trim()}, ${prompt.trim()}, fantasy character art, detailed digital illustration, headshot`;
    const encodedPrompt = encodeURIComponent(fullPrompt);
    const randomSeed = Math.floor(Math.random() * 10000);
    const generatedImageUrl = `https://image.pollinations.ai/prompt/${encodedPrompt}?seed=${randomSeed}&width=400&height=400&nologo=true`;

    return NextResponse.json({ url: generatedImageUrl });
}