import type { Metadata } from 'next';
import Link from 'next/link';
import { headers } from 'next/headers';
import './globals.css';

export const metadata: Metadata = {
  title: 'D&D Campaign Manager',
  description: 'A D&D campaign manager dashboard.',
};

export default async function RootLayout({ children }: Readonly<{ children: React.ReactNode }>) {
  const pathname = (await headers()).get('x-pathname') ?? '';
  const navigation = [
    { href: '/', label: 'Party Roster', icon: '♟' },
    { href: '/create', label: 'Character Creator', icon: '✦' },
    { href: '/maps', label: 'Map Studio', icon: '⌖' },
    { href: '/story', label: 'Story & Quests', icon: '❖' },
    { href: '/locations', label: 'World Directory', icon: '⌂' },
  ];

  return (
    <html lang="en">
      <body className="min-h-screen text-slate-100">
        <header className="sticky top-0 z-40 border-b border-amber-200/10 bg-[#090c12]/90 px-4 shadow-[0_12px_40px_rgba(0,0,0,0.28)] backdrop-blur-xl sm:px-6">
          <div className="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 py-3">
            <Link href="/" className="group flex items-center gap-3" aria-label="D&D Campaign Manager home">
              <span className="flex h-10 w-10 items-center justify-center rounded-xl border border-amber-300/25 bg-amber-400/10 text-xl text-amber-300 shadow-[inset_0_0_20px_rgba(214,168,79,0.12)] transition group-hover:border-amber-300/50">✦</span>
              <span>
                <span className="block text-[10px] font-bold uppercase tracking-[0.22em] text-amber-200/70">Adventurer’s Codex</span>
                <span className="block text-lg font-bold tracking-wide text-[#f1e8d6]">Campaign Manager</span>
              </span>
            </Link>
            <nav aria-label="Main navigation" className="flex w-full gap-1 overflow-x-auto pb-1 text-sm sm:w-auto sm:pb-0">
              {navigation.map((item) => {
                const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
                return (
                <Link
                  key={item.href}
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  className={`flex shrink-0 items-center gap-2 rounded-lg border px-3 py-2 font-sans text-xs font-semibold transition sm:text-sm ${active ? 'border-amber-300/20 bg-amber-300/10 text-amber-200 shadow-[inset_0_1px_rgba(255,255,255,0.04)]' : 'border-transparent text-slate-400 hover:border-white/5 hover:bg-white/5 hover:text-[#f1e8d6]'}`}
                >
                  <span aria-hidden="true" className="text-amber-400/80">{item.icon}</span>{item.label}
                </Link>
                );
              })}
            </nav>
          </div>
        </header>
        <div className="mx-auto min-h-[calc(100vh-80px)] max-w-7xl px-4 py-7 sm:px-6 sm:py-10">{children}</div>
      </body>
    </html>
  );
}
